# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown in the crawler User-Agent so site owners can reach you
CRAWLER_CONTACT_URL=http://localhost:3000/bot

# ---- Supabase (local: values printed by `supabase start`) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/worker only. Never expose to the browser.
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# ---- LLM (Phase 2+) ----
LLM_PROVIDER=mock            # mock | anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ---- Research (Phase 3+) ----
SEARCH_PROVIDER=mock         # mock | tavily | brave
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=       # optional, needs approval

# ---- Enrichment (Phase 5+) ----
ENRICHMENT_PROVIDERS=mockA,mockB

# ---- Jobs ----
# true: run jobs inline in the web process after enqueue (dev). false: only `npm run worker` runs them.
JOBS_INLINE=true
