# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown in the crawler User-Agent so site owners can reach you
CRAWLER_CONTACT_URL=http://localhost:3000/bot

# ---- Supabase (local: values printed by `npm run supabase:start`) ----
# Ports 55321-55324 are used so this doesn't collide with other local Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/worker/seed only. Never expose to the browser.
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# ---- LLM ----
# mock (no key; echoes site text, templated drafts) | deepseek (this project's default) | anthropic
LLM_PROVIDER=deepseek
# Optional. Defaults: deepseek -> deepseek-flash, anthropic -> claude-opus-5-5.
# DeepSeek options: deepseek-flash (fast, cheap) or deepseek-v4-pro (stronger).
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=

# ---- Research ----
# mock (fixture job boards labeled MOCK) | tavily | brave
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Reserved for the local-business play (not built yet); needs a Google Cloud billing account.
GOOGLE_PLACES_API_KEY=

# ---- Enrichment ----
# Comma-separated waterfall order. Built-in: mockA, mockB (addresses on .example only).
ENRICHMENT_PROVIDERS=mockA,mockB

# ---- Jobs ----
# true: run queued jobs inside the web process right after they're enqueued (dev).
# false: only `npm run worker` runs them (production).
JOBS_INLINE=true
# How often the worker polls, in ms.
WORKER_POLL_MS=2000
